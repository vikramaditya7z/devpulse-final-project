# Root Reference Environment Template for DevPulse
# Copy to server/.env and configure with real local/cloud credentials.
# Never commit real .env files to Git.

PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/devpulse
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=24h
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CLIENT_URL=http://localhost:5173
GITHUB_TOKEN=
