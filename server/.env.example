# Server Port
PORT=5001

# Node Environment (development, production, or test)
NODE_ENV=development

# MongoDB Connection String (Replace placeholder with your local or Atlas URI)
# Local example: mongodb://127.0.0.1:27017/devpulse
# Atlas example: mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/devpulse?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/devpulse

# JWT Secret & Expiration (Replace with a strong random secret of at least 32 characters)
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=24h

# Cookie Security (set to true in production with HTTPS)
COOKIE_SECURE=false

# Cookie SameSite setting (lax for same-origin, none for cross-origin HTTPS)
COOKIE_SAMESITE=lax

# Allowed Frontend Origin for CORS
CLIENT_URL=http://localhost:5173

# Optional: GitHub Personal Access Token to raise rate limits from 60 to 5,000 req/hr
# GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere
GITHUB_TOKEN=
